{
  "widgets": [
    {
      "type": "metric",
      "properties": {
        "title": "Backend CPU Utilization",
        "metrics": [
          ["AWS/EC2", "CPUUtilization", "AutoScalingGroupName", "production-backend-asg"]
        ],
        "period": 300,
        "stat": "Average",
        "region": "us-east-1",
        "view": "timeSeries"
      }
    },
    {
      "type": "metric",
      "properties": {
        "title": "ALB Request Count",
        "metrics": [
          ["AWS/ApplicationELB", "RequestCount", "LoadBalancer", "app/production-alb/644936730"]
        ],
        "period": 300,
        "stat": "Sum",
        "region": "us-east-1",
        "view": "timeSeries"
      }
    },
    {
      "type": "metric",
      "properties": {
        "title": "ALB Target Response Time",
        "metrics": [
          ["AWS/ApplicationELB", "TargetResponseTime", "LoadBalancer", "app/production-alb/644936730"]
        ],
        "period": 300,
        "stat": "Average",
        "region": "us-east-1",
        "view": "timeSeries"
      }
    },
    {
      "type": "metric",
      "properties": {
        "title": "ALB HTTP 5XX Errors",
        "metrics": [
          ["AWS/ApplicationELB", "HTTPCode_Target_5XX_Count", "LoadBalancer", "app/production-alb/644936730"]
        ],
        "period": 300,
        "stat": "Sum",
        "region": "us-east-1",
        "view": "timeSeries"
      }
    },
    {
      "type": "metric",
      "properties": {
        "title": "ElastiCache Redis CPU",
        "metrics": [
          ["AWS/ElastiCache", "CPUUtilization", "CacheClusterId", "production-redis"]
        ],
        "period": 300,
        "stat": "Average",
        "region": "us-east-1",
        "view": "timeSeries"
      }
    },
    {
      "type": "metric",
      "properties": {
        "title": "ASG Instance Count",
        "metrics": [
          ["AWS/AutoScaling", "GroupInServiceInstances", "AutoScalingGroupName", "production-backend-asg"]
        ],
        "period": 300,
        "stat": "Average",
        "region": "us-east-1",
        "view": "timeSeries"
      }
    },
    {
      "type": "log",
      "properties": {
        "title": "Backend Application Logs",
        "query": "SOURCE '/starttech/production/backend' | fields @timestamp, @message | sort @timestamp desc | limit 50",
        "region": "us-east-1",
        "view": "table"
      }
    }
  ]
}
